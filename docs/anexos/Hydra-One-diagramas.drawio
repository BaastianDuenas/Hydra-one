 vertex="1" parent="1"><mxGeometry as="geometry" x="49" y="538" width="832" height="129" /></mxCell><mxCell id="58" value="" style="shape=rectangle;rounded=0;fillColor=#fff7e8;strokeColor=#e7bf7a;strokeWidth=1.6;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="965" y="530" width="365" height="145" /></mxCell><mxCell id="59" value="No hay tablas de usuarios, consumos,&#10;movimientos ni alertas persistidas.&#10;&#10;Esquema deducido de modelos y&#10;migraciones; no inspeccionado en Neon." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="979" y="538" width="337" height="129" /></mxCell></root></mxGraphModel></diagram><diagram id="05-secuencia-alta" name="05 / Secuencia UML · registrar una mantención"><mxGraphModel dx="1220" dy="1060" grid="1" gridSize="10" page="1" pageWidth="1220" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="05 / Secuencia UML · registrar una mantención" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="20" width="1156" height="35" /></mxCell><mxCell id="3" value="ACTUAL · verificado en código" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#087f8c;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="62" width="1156" height="25" /></mxCell><mxCell id="4" value="HYDRA-ONE  /  Anexo técnico  /  28 oct 2026  /  fuente: código 5d449af" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#62748b;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="1025" width="1156" height="22" /></mxCell><mxCell id="7" value="" style="group;" vertex="1" parent="1"><mxGeometry as="geom